{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://internal.example/schemas/skill-manifest.schema.json",
  "title": "Skill Manifest",
  "type": "object",
  "required": [
    "name",
    "slug",
    "version",
    "summary",
    "owners",
    "stability",
    "tags",
    "recommendedVersion",
    "minSafeVersion"
  ],
  "properties": {
    "name": { "type": "string", "minLength": 3 },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "summary": { "type": "string", "minLength": 10 },
    "owners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "contact"],
        "properties": {
          "name": { "type": "string" },
          "contact": { "type": "string" }
        }
      }
    },
    "stability": {
      "type": "string",
      "enum": ["stable", "beta", "deprecated"]
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "recommendedVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "minSafeVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "description": { "type": "string" }
  },
  "additionalProperties": true
}
